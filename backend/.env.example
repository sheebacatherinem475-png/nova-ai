ALLOWED_HOSTS=*

# File Storage
UPLOAD_DIR=uploads-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
